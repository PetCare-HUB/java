digraph DER {
  rankdir=LR;
  node [shape=record, fontname="Arial", style="filled", fillcolor="#f8fbff", color="#315a7d"];
  edge [color="#315a7d", fontname="Arial"];

  RESPONSAVEL [label="{T_RESPONSAVEL|PK ID_RESPONSAVEL\lNOME\lEMAIL\lCPF\lTELEFONE\l}"];
  CLINICA [label="{T_CLINICA|PK ID_CLINICA\lNOME\lCNPJ\lENDERECO\l}"];
  PET [label="{T_PET|PK ID_PET\lFK ID_RESPONSAVEL\lFK ID_CLINICA\lNOME\lESPECIE\lSCORE_ATUAL\l}"];
  CONSULTA [label="{T_CONSULTA|PK ID_CONSULTA\lFK ID_PET\lFK ID_CLINICA\lDATA_CONSULTA\lTIPO\l}"];
  COLEIRA [label="{T_LEITURA_COLEIRA|PK ID_LEITURA_COLEIRA\lFK ID_PET\lSTATUS_ATIVIDADE\lNIVEL_BATERIA\l}"];
  COMEDOURO [label="{T_LEITURA_COMEDOURO|PK ID_LEITURA_COMEDOURO\lFK ID_PET\lNIVEL_RACAO_PCT\lPESO_CONSUMIDO_G\l}"];
  AMBIENTE [label="{T_LEITURA_AMBIENTE|PK ID_LEITURA_AMBIENTE\lFK ID_PET\lTEMPERATURA\lUMIDADE\lQUALIDADE_AR\l}"];
  ALERTA [label="{T_ALERTA_SAUDE|PK ID_ALERTA\lFK ID_PET\lTIPO\lNIVEL\lRESOLVIDO\l}"];
  SCORE [label="{T_SCORE_SAUDE|PK ID_SCORE\lFK ID_PET\lSCORE\lCATEGORIA\l}"];
  EVENTO [label="{T_EVENTO_PREVENTIVO|PK ID_EVENTO\lFK ID_PET\lTIPO\lDATA_PREVISTA\l}"];
  PROTOCOLO [label="{T_PROTOCOLO_PREVENTIVO|PK ID_PROTOCOLO\lESPECIE\lTIPO\lNOME\l}"];

  RESPONSAVEL -> PET [label="1:N"];
  CLINICA -> PET [label="1:N"];
  PET -> CONSULTA [label="1:N"];
  CLINICA -> CONSULTA [label="1:N"];
  PET -> COLEIRA [label="1:N"];
  PET -> COMEDOURO [label="1:N"];
  PET -> AMBIENTE [label="1:N"];
  PET -> ALERTA [label="1:N"];
  PET -> SCORE [label="1:N"];
  PET -> EVENTO [label="1:N"];
}
